<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f1f5f9;color:#1e293b;font-size:14px}
.banniere{background:#1e3a5f;color:#93c5fd;text-align:center;padding:8px 16px;font-size:12px;position:fixed;top:0;left:0;right:0;z-index:999}
.banniere a{color:#60a5fa;text-decoration:none}
.topbar{background:#2D3F7B;color:#fff;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;position:fixed;top:36px;left:0;right:0;z-index:998}
.nav{background:#253570;display:flex;padding:0 24px;gap:2px;overflow-x:auto;position:fixed;top:96px;left:0;right:0;z-index:997}
.contenu{padding:24px;padding-top:140px;max-width:1400px;margin:0 auto}
.topbar-logo{display:flex;align-items:center;gap:12px}
.topbar-titre{font-size:14px;font-weight:500;opacity:.9}
.topbar-droite{display:flex;align-items:center;gap:16px;font-size:13px}
.pill-role{background:rgba(255,255,255,.2);padding:3px 10px;border-radius:20px;font-size:11px;font-weight:500}
.btn-deconnexion{background:none;border:1px solid rgba(255,255,255,.4);color:#fff;padding:5px 12px;border-radius:6px;font-size:12px;cursor:pointer}
.btn-deconnexion:hover{background:rgba(255,255,255,.1)}
.nav-btn{color:rgba(255,255,255,.7);font-size:13px;padding:10px 16px;border:none;background:none;border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap;text-decoration:none;display:inline-block}
.nav-btn:hover{color:#fff}
.nav-btn.actif{color:#fff;border-bottom-color:#7B9EC8;background:rgba(255,255,255,.08)}
.page-titre{font-size:22px;font-weight:600;color:#1e293b;margin-bottom:4px}
.page-soustitre{font-size:13px;color:#64748b;margin-bottom:20px}

/* Layout principal */
.layout{display:block}
.colonne-principale{min-width:0}


/* Filtres */
.filtres-bloc{background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.filtre-label{font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}
.filtre-select{border:1px solid #e2e8f0;border-radius:6px;padding:6px 10px;font-size:12px;color:#1e293b;background:#f8fafc;cursor:pointer;outline:none}
.filtre-select:focus{border-color:#7B9EC8}
.filtre-date{border:1px solid #e2e8f0;border-radius:6px;padding:6px 10px;font-size:12px;color:#1e293b;background:#f8fafc;cursor:pointer;outline:none}
.filtre-separateur{color:#94a3b8;font-size:12px}
.btn-filtre{background:#2D3F7B;color:#fff;border:none;border-radius:6px;padding:6px 14px;font-size:12px;cursor:pointer;font-weight:500}
.btn-filtre:hover{background:#253570}
.btn-filtre-reset{background:none;color:#64748b;border:1px solid #e2e8f0;border-radius:6px;padding:6px 14px;font-size:12px;cursor:pointer}
.btn-filtre-reset:hover{background:#f8fafc}

/* Section titre */
.section-titre{font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin:20px 0 10px;display:flex;align-items:center;justify-content:space-between}
.btn-ajouter{background:#2D3F7B;color:#fff;border:none;border-radius:6px;padding:5px 12px;font-size:11px;cursor:pointer;font-weight:600;display:flex;align-items:center;gap:5px}
.btn-ajouter:hover{background:#253570}
.btn-ajouter svg{width:12px;height:12px}

/* Organes */
.organe-bloc{background:#fff;border:1px solid #e2e8f0;border-radius:10px;overflow:hidden;margin-bottom:10px}
.organe-entete{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;cursor:pointer;user-select:none;transition:.15s}
.organe-entete:hover{background:#f8fafc}
.organe-gauche{display:flex;align-items:center;gap:12px}
.organe-sigle{width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0}
.organe-nom{font-size:13px;font-weight:600;color:#1e293b}
.organe-sous{font-size:11px;color:#64748b;margin-top:1px}
.organe-droite{display:flex;align-items:center;gap:10px}
.organe-count{background:#E8EEF7;color:#2D3F7B;font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px}
.organe-fleche{color:#94a3b8;font-size:16px;transition:.2s;display:inline-block}
.organe-fleche.ouvert{transform:rotate(180deg)}
.organe-corps{border-top:1px solid #e2e8f0;display:none}
.organe-corps.ouvert{display:block}

/* Sélecteur année dans organe */
.organe-annees{display:flex;gap:6px;padding:12px 18px;border-bottom:1px solid #f1f5f9;background:#f8fafc;flex-wrap:wrap;align-items:center}
.annee-label{font-size:11px;color:#64748b;font-weight:600}
.btn-annee{border:1px solid #e2e8f0;background:#fff;border-radius:20px;padding:3px 10px;font-size:11px;cursor:pointer;color:#64748b}
.btn-annee:hover{border-color:#7B9EC8;color:#2D3F7B}
.btn-annee.actif{background:#2D3F7B;color:#fff;border-color:#2D3F7B}

/* Rencontres */
.rencontres-liste{padding:8px 0}
.rencontre-item{border-bottom:1px solid #f1f5f9}
.rencontre-item:last-child{border-bottom:none}
.rencontre-entete{display:flex;align-items:center;justify-content:space-between;padding:10px 18px;cursor:pointer;transition:.1s}
.rencontre-entete:hover{background:#f8fafc}
.rencontre-gauche{display:flex;align-items:center;gap:10px}
.rencontre-date-badge{background:#E8EEF7;color:#2D3F7B;font-size:10px;font-weight:700;padding:3px 8px;border-radius:5px;white-space:nowrap;min-width:90px;text-align:center}
.rencontre-nom{font-size:12px;font-weight:600;color:#1e293b}
.rencontre-sous{font-size:11px;color:#94a3b8;margin-top:1px}
.rencontre-droite{display:flex;align-items:center;gap:8px}
.doc-pill{display:flex;align-items:center;gap:3px;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:20px;padding:2px 8px;font-size:10px;color:#64748b}
.doc-pill.ok{background:#dcfce7;border-color:#bbf7d0;color:#166534}
.doc-pill svg{width:10px;height:10px}
.rencontre-fleche{color:#94a3b8;font-size:14px;transition:.2s}
.rencontre-fleche.ouvert{transform:rotate(180deg)}

/* Contenu rencontre */
.rencontre-corps{background:#f8fafc;border-top:1px solid #f1f5f9;padding:14px 18px;display:none}
.rencontre-corps.ouvert{display:block}
.docs-grille{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.doc-carte{background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:12px 14px}
.doc-carte-titre{font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px;display:flex;align-items:center;gap:5px}
.doc-carte-titre svg{width:12px;height:12px;color:#2D3F7B}
.doc-upload{border:1.5px dashed #cbd5e1;border-radius:6px;padding:10px;text-align:center;cursor:pointer;transition:.15s}
.doc-upload:hover{border-color:#7B9EC8;background:#E8EEF7}
.doc-upload-texte{font-size:11px;color:#94a3b8}
.doc-upload-texte strong{color:#2D3F7B;display:block;margin-bottom:2px}
.doc-fichier{display:flex;align-items:center;gap:8px;padding:8px 10px;background:#f1f5f9;border-radius:6px;cursor:pointer;transition:.15s}
.doc-fichier:hover{background:#E8EEF7}
.doc-fichier-nom{font-size:11px;color:#1e293b;font-weight:500;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.doc-fichier-date{font-size:10px;color:#94a3b8}
.btn-telecharger{background:none;border:none;color:#2D3F7B;cursor:pointer;font-size:10px;font-weight:600;padding:2px 6px;border-radius:4px}
.btn-telecharger:hover{background:#E8EEF7}
.rencontre-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid #e2e8f0}
.btn-sm{font-size:11px;padding:5px 10px;border-radius:5px;cursor:pointer;font-weight:500;border:none}
.btn-sm-bleu{background:#2D3F7B;color:#fff}
.btn-sm-bleu:hover{background:#253570}
.btn-sm-rouge{background:#fee2e2;color:#7f1d1d;border:1px solid #fca5a5}
.btn-sm-rouge:hover{background:#fca5a5}

/* Ajouter rencontre */
.btn-ajouter-rencontre{display:flex;align-items:center;gap:6px;width:100%;padding:10px 18px;background:none;border:none;border-top:1px solid #f1f5f9;color:#2D3F7B;font-size:12px;font-weight:600;cursor:pointer;text-align:left}
.btn-ajouter-rencontre:hover{background:#f8fafc}

/* Colonne droite — tâches */












.tache-assign{font-size:10px;font-weight:600;color:#2D3F7B}



.badge-vert{background:#dcfce7;color:#166534}

/* Mini calendrier */























/* Modal ajout */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:2000;align-items:center;justify-content:center}
.modal-overlay.ouvert{display:flex}
.modal{background:#fff;border-radius:12px;padding:24px;width:480px;max-width:90vw;box-shadow:0 20px 60px rgba(0,0,0,.15)}
.modal-titre{font-size:16px;font-weight:700;color:#1e293b;margin-bottom:16px}
.form-groupe{margin-bottom:12px}
.form-label{font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;display:block}
.form-input{width:100%;border:1px solid #e2e8f0;border-radius:6px;padding:8px 10px;font-size:13px;color:#1e293b;outline:none}
.form-input:focus{border-color:#7B9EC8}
.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
.btn-modal-annuler{background:none;border:1px solid #e2e8f0;color:#64748b;border-radius:6px;padding:7px 16px;font-size:12px;cursor:pointer}
.btn-modal-ok{background:#2D3F7B;color:#fff;border:none;border-radius:6px;padding:7px 16px;font-size:12px;cursor:pointer;font-weight:600}
</style>
</head>
