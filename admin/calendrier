<script>
// ===== ORGANES =====
function toggleOrgane(id) {
  const corps = document.getElementById('corps-' + id);
  const fleche = document.getElementById('fleche-' + id);
  const ouvert = corps.classList.contains('ouvert');
  corps.classList.toggle('ouvert', !ouvert);
  fleche.classList.toggle('ouvert', !ouvert);
}

// ===== RENCONTRES =====
function toggleRencontre(id) {
  const corps = document.getElementById('corps-' + id);
  const fleche = document.getElementById('fleche-' + id);
  const ouvert = corps.classList.contains('ouvert');
  corps.classList.toggle('ouvert', !ouvert);
  fleche.classList.toggle('ouvert', !ouvert);
}

// ===== UPLOAD simulé =====
function simulerUpload(nom) {
  alert('Dans la vraie version : téléversement de "' + nom + '" vers SharePoint REFC.');
}

// ===== SUPPRIMER =====
function supprimerRencontre(nom) {
  if (confirm('Supprimer la rencontre "' + nom + '" et tous ses documents ?')) {
    alert('Dans la vraie version : suppression dans SharePoint.');
  }
}

// ===== MODAL =====
function ouvrirModal(sigle, nom) {
  document.getElementById('modal-titre').textContent = 'Ajouter une rencontre — ' + (nom || 'Organe');
  document.getElementById('modal-organe').value = sigle ? sigle + ' — ' + nom : '';
  document.getElementById('modal-overlay').classList.add('ouvert');
}
function fermerModal(e) {
  if (e.target === document.getElementById('modal-overlay'))
    document.getElementById('modal-overlay').classList.remove('ouvert');
}
function confirmerAjout() {
  const date = document.getElementById('modal-date').value;
  const organe = document.getElementById('modal-organe').value;
  if (!date) { alert('Veuillez choisir une date.'); return; }
  alert('Dans la vraie version : rencontre ajoutée dans SharePoint.\n' + organe + ' — ' + date);
  document.getElementById('modal-overlay').classList.remove('ouvert');
}

// ===== FILTRES =====
function appliquerFiltres() {
  const annee = document.getElementById('filtre-annee').value;
  const debut = document.getElementById('date-debut').value;
  const fin = document.getElementById('date-fin').value;
  alert('Dans la vraie version : filtrage par année=' + (annee||'toutes') + ', période ' + debut + ' → ' + fin);
}
function resetFiltres() {
  document.getElementById('filtre-annee').value = '2026';
  document.getElementById('date-debut').value = '2025-09-01';
  document.getElementById('date-fin').value = '2026-08-31';
}

// ===== MINI CALENDRIER =====

}
</script>
